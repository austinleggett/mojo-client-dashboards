// Prisma schema for Mountain Mojo's client dashboard app.
// One table. Each client's entire dashboard (stats, momentum, stores,
// review items, questions, tasks, approved items, events, meetings) is
// stored as a single JSON blob in `content`, the same shape the page
// renders from. This keeps adding new sections/fields a code change,
// not a database migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Client {
  id          String   @id @default(cuid())
  // Long, unguessable slug used in the private client link: /c/<slug>.
  // Not just a pretty name-based slug -- includes a random suffix so
  // the URL itself can't be guessed by trying company names.
  slug        String   @unique
  name        String
  active      Boolean  @default(true)
  accentColor String   @default("#1f4d3a")
  // Set by staff in edit mode to turn on the client-facing "portal"
  // login at /c/<slug> (see app/c/[slug]/page.js and lib/auth.js).
  // Null/empty = no password gate yet -- the dashboard is still
  // reachable by anyone with the link, same as before this existed.
  // Stored as plain text, like STAFF_PASSWORD, rather than hashed --
  // consistent with this app's existing one-shared-password model, and
  // deliberately never sent back to the browser once set (see
  // lib/db.js's toSafeClient, used everywhere a Client record reaches
  // client-rendered code or a JSON response).
  clientPassword String?
  // The Weekly Update tab, as the client sees it. Also holds `meta`
  // (client name, logo, strategist contact...), which is shared by both
  // tabs and never drafted -- see app/api/clients/[slug]/route.js.
  content     Json
  // The Monthly Meeting tab, as the client sees it. Null until staff
  // set the tab up (the client doesn't see a Monthly tab until then).
  monthlyContent Json?
  // Work-in-progress drafts of each tab. While one exists, staff edit
  // the draft and the client keeps seeing the published version above;
  // "Publish" copies the draft over it (saving the old one to
  // ClientVersion first) and clears the draft.
  draftContent        Json?
  draftMonthlyContent Json?
  versions    ClientVersion[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Staff-only backups: the published version of a tab as it was just
// before each publish (or restore), so a bad publish can be rolled
// back. The newest 25 per tab are kept.
model ClientVersion {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  view      String   // "weekly" | "monthly"
  content   Json
  note      String?
  createdAt DateTime @default(now())

  @@index([clientId, view, createdAt])
}
