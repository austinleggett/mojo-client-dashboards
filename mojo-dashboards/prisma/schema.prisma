// Prisma schema for Mountain Mojo's client dashboard app.
// One table. Each client's entire dashboard (stats, momentum, stores,
// review items, questions, tasks, approved items, events, meetings) is
// stored as a single JSON blob in `content`, the same shape the page
// renders from. This keeps adding new sections/fields a code change,
// not a database migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Client {
  id          String   @id @default(cuid())
  // Long, unguessable slug used in the private client link: /c/<slug>.
  // Not just a pretty name-based slug -- includes a random suffix so
  // the URL itself can't be guessed by trying company names.
  slug        String   @unique
  name        String
  active      Boolean  @default(true)
  accentColor String   @default("#1f4d3a")
  // Set by staff in edit mode to turn on the client-facing "portal"
  // login at /c/<slug> (see app/c/[slug]/page.js and lib/auth.js).
  // Null/empty = no password gate yet -- the dashboard is still
  // reachable by anyone with the link, same as before this existed.
  // Stored as plain text, like STAFF_PASSWORD, rather than hashed --
  // consistent with this app's existing one-shared-password model, and
  // deliberately never sent back to the browser once set (see
  // lib/db.js's toSafeClient, used everywhere a Client record reaches
  // client-rendered code or a JSON response).
  clientPassword String?
  content     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
